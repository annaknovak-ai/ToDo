{
  "name": "todo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "vercel dev",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.api.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "test:prod": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright test --config playwright.prod.config.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "icons": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 tsx scripts/generate-icons.ts",
    "db:push": "supabase db push --linked",
    "postinstall": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vercel/node": "^27.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.0",
    "jsdom": "^30.1.3",
    "supabase": "^2.122.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vercel": "^65.2.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
